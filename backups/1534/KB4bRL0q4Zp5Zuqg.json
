":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-176,0],"id":"298771e5-e539-442c-9733-f0b8e16fa264","name":"Webhook","webhookId":"fb3f4826-88c0-4b63-878b-319419fa37cc"},{"parameters":{"jsCode":"// Récupération des données du Webhook\nconst data = items[0].json.body;\n\nconst budget = data.cash_amount || 5000; // 5000€ par défaut\nconst price = parseFloat(data.limit_price); // Prix envoyé par TradingView\n\n// Calcul : Budget / Prix = Nombre d'actions (arrondi à l'entier inférieur)\n// Ex: 5000 / 112.50 = 44.44 -> 44 actions\nconst quantity = Math.floor(budget / price);\n\n// On prépare les données pour la suite\nreturn {\n  json: {\n    ticker: data.ticker,          // \"SK\"\n    exchange: data.exchange,      // \"SBF\"\n    action: data.action,          // \"BUY\"\n    quantity: quantity,           // 44\n    limit_price: price            // 112.5\n  }\n};\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[32,0],"id":"c4e7b496-959e-41d4-b360-7d8238cc4473","name":"Code in JavaScript"},{"parameters":{"chatId":"7562186427","text":"={{ $json.body }}","additionalFields":{}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[464,0],"id":"6a479801-ea0c-4d3e-ac5a-52da5be68402","name":"Send a text message","webhookId":"294c6f08-0db0-4026-b0f6-ca7ff5639eb9","credentials":{"telegramApi":{"id":"jSeEXVsbMIcnLuls","name":"Telegram account"}}}],"connections":{"Webhook":{"main":[[{"node":"Code in JavaScript","type":"main","index":0}]]},"Code in JavaScript":{"main":[[{"node":"Send a text message","type":"main","index":0}]]},"HTTP Request":{"main":[[]]}},"authors":"ludo h","name":"Version e0af61ac","description":""},"tags":[]}